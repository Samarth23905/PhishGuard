# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_TOKEN=replace-with-a-long-random-secret
PORT=5000
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=30

# Remote webpage fetching is disabled by default. Enable only after deployment
# network egress controls are in place and the SSRF protections are reviewed.
PHISHGUARD_ENABLE_PAGE_FETCH=false

# Optional Firebase Admin service account path. Keep the real JSON out of Git.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
