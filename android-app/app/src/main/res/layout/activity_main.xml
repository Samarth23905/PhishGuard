<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center"
    android:padding="32dp" android:background="#F8F9FA">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="🛡️ PhishGuard DL" android:textSize="30sp"
        android:textStyle="bold" android:textColor="#1A73E8"
        android:layout_marginBottom="6dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="AI Phishing Detector — 4 Layer DL Pipeline"
        android:textSize="13sp" android:textColor="#5F6368"
        android:layout_marginBottom="40dp"/>

    <androidx.cardview.widget.CardView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        app:cardCornerRadius="16dp" app:cardElevation="4dp"
        android:layout_marginBottom="28dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="24dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="SCANNER STATUS" android:textSize="11sp"
                android:textColor="#5F6368" android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"/>
            <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Checking..."
                android:textSize="15sp" android:textStyle="bold"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button android:id="@+id/btnGrant"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:text="Grant Notification Access"
        android:backgroundTint="#1A73E8" android:textColor="#FFFFFF"
        style="@style/Widget.MaterialComponents.Button"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Layer 1: Sender whitelist\nLayer 2: URL deep learning model\nLayer 3: Page content model\nLayer 4: Smart summarizer\n\nZero AI API keys — runs fully offline."
        android:textSize="12sp" android:textColor="#5F6368"
        android:gravity="center" android:layout_marginTop="28dp"
        android:lineSpacingMultiplier="1.5"/>

</LinearLayout>
